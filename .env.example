# URL base de la API. En desarrollo el mock (MSW) intercepta este prefijo.
VITE_API_URL=/api

# Activa el mock service worker en desarrollo. En tests MSW siempre está activo.
VITE_ENABLE_MOCKS=true

# Habilita módulos experimentales (por ejemplo, escenarios de proyección).
# Por defecto están fuera de alcance.
VITE_ENABLE_SCENARIOS=false
