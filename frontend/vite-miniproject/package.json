{
  "name": "vite-miniproject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "turbo typecheck",
    "prepare": "git config core.hooksPath frontend/vite-miniproject/.husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
